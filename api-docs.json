{
  "openapi": "3.0.0",
  "info": {
    "title": "杨爽短链接系统 API",
    "description": "杨爽短链接系统开放接口文档，支持短链接创建、管理、统计、广告配置等功能。\n\n## 认证方式\n- 使用 JWT Token 认证\n- 登录成功后获取 Token，后续请求在 Header 中添加 `Authorization: Bearer {token}`\n\n## 通用响应格式\n```json\n{\n  \"code\": 0,\n  \"msg\": \"success\",
  \"data\": {}\n}\n```\n\n## 错误码说明\n| code | 说明 |\n|------|------|\n| 0 | 成功 |\n| 400 | 请求参数错误 |\n| 401 | 未登录或Token无效 |\n| 403 | 权限不足 |\n| 404 | 资源不存在 |\n| 429 | 操作过于频繁 |\n| 500 | 服务器内部错误 |",
    "version": "2.0.0",
    "contact": {
      "name": "技术支持"
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "当前服务器"
    }
  ],
  "tags": [
    { "name": "安装", "description": "系统安装向导接口" },
    { "name": "认证", "description": "用户登录、注册、Token管理" },
    { "name": "短链接", "description": "短链接的创建、查询、管理" },
    { "name": "公开接口", "description": "无需认证的公开接口" },
    { "name": "管理员", "description": "后台管理功能（需管理员权限）" },
    { "name": "API开放", "description": "对外开放的API接口" }
  ],
  "paths": {
    "/install/status": {
      "get": {
        "tags": ["安装"],
        "summary": "检查安装状态",
        "description": "检查系统是否已完成安装",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "installed": { "type": "boolean", "description": "是否已安装" },
                    "dbError": { "type": "boolean", "description": "数据库是否可用" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/test-connection": {
      "post": {
        "tags": ["安装"],
        "summary": "测试数据库连接",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["database"],
                "properties": {
                  "host": { "type": "string", "default": "localhost" },
                  "port": { "type": "integer", "default": 3306 },
                  "database": { "type": "string", "description": "数据库名" },
                  "username": { "type": "string", "default": "root" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "连接成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "connected": { "type": "boolean" },
                    "hasTables": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/setup": {
      "post": {
        "tags": ["安装"],
        "summary": "执行系统安装",
        "description": "创建数据库表、初始化配置、创建管理员账号",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "db": {
                    "type": "object",
                    "properties": {
                      "host": { "type": "string" },
                      "port": { "type": "integer" },
                      "database": { "type": "string" },
                      "username": { "type": "string" },
                      "password": { "type": "string" }
                    }
                  },
                  "admin": {
                    "type": "object",
                    "required": ["username", "password"],
                    "properties": {
                      "username": { "type": "string", "description": "管理员账号（至少3字符）" },
                      "password": { "type": "string", "description": "密码（至少6字符）" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "安装成功" },
          "400": { "description": "参数错误" },
          "500": { "description": "安装失败" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["认证"],
        "summary": "用户登录",
        "description": "使用用户名和密码登录系统",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "admin", "description": "用户名" },
                  "password": { "type": "string", "example": "admin123", "description": "密码" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "登录成功",
                  "data": {
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                    "user": {
                      "id": 1,
                      "username": "admin",
                      "role": "admin",
                      "daily_limit": 9999
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["认证"],
        "summary": "用户注册",
        "description": "注册新用户账号",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "newuser", "description": "用户名（3-32字符）" },
                  "password": { "type": "string", "example": "123456", "description": "密码（至少6位）" },
                  "invite_code": { "type": "string", "description": "邀请码（邀请注册模式必填）" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "注册成功",
                  "data": {
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                    "user": { "id": 2, "username": "newuser", "role": "user" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": ["认证"],
        "summary": "获取当前用户信息",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": {
                    "id": 1,
                    "username": "admin",
                    "role": "admin",
                    "daily_limit": 9999,
                    "total_links": 156,
                    "created_at": "2024-01-01 00:00:00"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["认证"],
        "summary": "更新个人资料",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nickname": { "type": "string", "description": "昵称" },
                  "password": { "type": "string", "description": "新密码（至少6位）" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "更新成功" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["认证"],
        "summary": "刷新Token",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": { "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
                }
              }
            }
          }
        }
      }
    },
    "/link/create": {
      "post": {
        "tags": ["短链接"],
        "summary": "创建短链接",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["original_url"],
                "properties": {
                  "original_url": { "type": "string", "example": "https://www.example.com/very-long-url", "description": "原始长链接" },
                  "short_code": { "type": "string", "description": "自定义短码（可选，4-16位）" },
                  "title": { "type": "string", "description": "备注标题" },
                  "expire_days": { "type": "integer", "description": "有效期天数，0=永久" },
                  "password": { "type": "string", "description": "访问密码（可选）" },
                  "domain_id": { "type": "integer", "description": "绑定域名ID" },
                  "no_ad": { "type": "integer", "description": "是否免广告 0=否 1=是" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "短链接创建成功",
                  "data": {
                    "id": 1,
                    "short_code": "abc123",
                    "short_url": "https://ysdj.cn/abc123"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/link/batch": {
      "post": {
        "tags": ["短链接"],
        "summary": "批量创建短链接",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["urls"],
                "properties": {
                  "urls": {
                    "type": "array",
                    "description": "URL列表，最多500条",
                    "items": { "type": "string" },
                    "example": ["https://example.com/1", "https://example.com/2"]
                  },
                  "expire_days": { "type": "integer", "description": "有效期天数" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "批量创建成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "成功创建 2 条短链接",
                  "data": {
                    "success": 2,
                    "failed": 0,
                    "links": [
                      { "id": 1, "short_code": "abc001", "short_url": "https://ysdj.cn/abc001", "original_url": "https://example.com/1" },
                      { "id": 2, "short_code": "abc002", "short_url": "https://ysdj.cn/abc002", "original_url": "https://example.com/2" }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/link/my": {
      "get": {
        "tags": ["短链接"],
        "summary": "获取我的链接列表",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "页码" },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "每页条数" },
          { "name": "keyword", "in": "query", "schema": { "type": "string" }, "description": "搜索关键词" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["1", "0"] }, "description": "状态筛选" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": {
                    "list": [
                      { "id": 1, "short_code": "abc123", "short_url": "https://ysdj.cn/abc123", "original_url": "https://example.com", "pv": 100, "status": 1 }
                    ],
                    "total": 156,
                    "page": 1,
                    "page_size": 20
                  }
                }
              }
            }
          }
        }
      }
    },
    "/link/{id}": {
      "get": {
        "tags": ["短链接"],
        "summary": "获取链接详情",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "链接ID" }
        ],
        "responses": {
          "200": { "description": "成功" }
        }
      },
      "put": {
        "tags": ["短链接"],
        "summary": "更新链接",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "original_url": { "type": "string", "description": "新链接地址" },
                  "title": { "type": "string", "description": "备注标题" },
                  "status": { "type": "integer", "enum": [0, 1], "description": "状态" },
                  "expire_days": { "type": "integer", "description": "有效期" },
                  "password": { "type": "string", "description": "访问密码" },
                  "no_ad": { "type": "integer", "description": "免广告" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "更新成功" } }
      },
      "delete": {
        "tags": ["短链接"],
        "summary": "删除链接（移入回收站）",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "删除成功" } }
      }
    },
    "/link/{id}/restore": {
      "post": {
        "tags": ["短链接"],
        "summary": "恢复已删除的链接",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "恢复成功" } }
      }
    },
    "/link/{id}/stats": {
      "get": {
        "tags": ["短链接"],
        "summary": "获取链接统计",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "period", "in": "query", "schema": { "type": "string", "enum": ["7d", "30d", "90d"], "default": "7d" }, "description": "统计周期" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": {
                    "link": { "id": 1, "short_code": "abc123", "pv": 1000, "uv": 800, "ip_count": 500 },
                    "trends": [
                      { "stat_date": "2024-01-01", "pv": 100, "uv": 80 },
                      { "stat_date": "2024-01-02", "pv": 120, "uv": 95 }
                    ],
                    "regions": [
                      { "province": "广东", "cnt": 300 },
                      { "province": "北京", "cnt": 200 }
                    ],
                    "devices": [
                      { "device_type": "mobile", "cnt": 600 },
                      { "device_type": "desktop", "cnt": 400 }
                    ],
                    "browsers": [
                      { "browser": "Chrome", "cnt": 500 },
                      { "browser": "Safari", "cnt": 300 }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/settings/public": {
      "get": {
        "tags": ["公开接口"],
        "summary": "获取公开设置",
        "description": "获取前端页面需要的公开配置，无需认证",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": {
                    "site_name": "杨爽短链接",
                    "site_logo": "",
                    "allow_register": 1,
                    "guest_create": 1,
                    "captcha_enable": 0,
                    "redirect_seconds": 5
                  }
                }
              }
            }
          }
        }
      }
    },
    "/link/query": {
      "get": {
        "tags": ["公开接口"],
        "summary": "公开查询短链信息",
        "description": "根据短码查询链接信息（需开启公开查询）",
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" }, "description": "短码" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": {
                    "short_code": "abc123",
                    "pv": 1000,
                    "uv": 800,
                    "created_at": "2024-01-01 00:00:00",
                    "status": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "/link/{id}/qrcode": {
      "get": {
        "tags": ["公开接口"],
        "summary": "获取二维码",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 150 }, "description": "二维码尺寸" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": {
                    "qr_url": "data:image/png;base64,...",
                    "short_url": "https://ysdj.cn/abc123"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ad/{code}": {
      "get": {
        "tags": ["公开接口"],
        "summary": "获取链接广告信息",
        "description": "获取指定短链关联的广告内容",
        "parameters": [
          { "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": {
                    "ad_id": 1,
                    "image_url": "https://example.com/ad.png",
                    "target_url": "https://example.com"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/dashboard": {
      "get": {
        "tags": ["管理员"],
        "summary": "仪表盘数据",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": {
                    "totalLinks": 156,
                    "totalVisits": 50000,
                    "todayVisits": 1234,
                    "totalUsers": 50,
                    "hotLinks": [
                      { "id": 1, "short_code": "abc123", "pv": 5000 }
                    ],
                    "trends": [
                      { "stat_date": "2024-01-01", "pv": 1000 }
                    ],
                    "devices": [
                      { "device_type": "mobile", "cnt": 30000 }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/links": {
      "get": {
        "tags": ["管理员"],
        "summary": "获取所有链接（管理员）",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer" } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "deleted", "in": "query", "schema": { "type": "string", "enum": ["0", "1"] }, "description": "是否回收站" },
          { "name": "user_id", "in": "query", "schema": { "type": "integer" }, "description": "按用户筛选" }
        ],
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/admin/link/{id}": {
      "delete": {
        "tags": ["管理员"],
        "summary": "永久删除链接",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "删除成功" } }
      }
    },
    "/admin/links/import": {
      "post": {
        "tags": ["管理员"],
        "summary": "批量导入链接（CSV）",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["urls"],
                "properties": {
                  "urls": { "type": "array", "items": { "type": "string" }, "description": "URL列表" },
                  "user_id": { "type": "integer", "description": "归属用户ID" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "导入成功",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "msg": "成功导入 100 条链接"
                }
              }
            }
          }
        }
      }
    },
    "/admin/links/export": {
      "get": {
        "tags": ["管理员"],
        "summary": "导出链接列表（CSV）",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "返回CSV文件",
            "content": {
              "text/csv": { "schema": { "type": "string" } }
            }
