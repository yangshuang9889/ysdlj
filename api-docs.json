  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Token 认证。登录成功后获取 Token，后续请求在 Header 中添加 `Authorization: Bearer {token}`"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "用户ID" },
          "username": { "type": "string", "description": "用户名" },
          "role": { "type": "string", "enum": ["admin", "operator", "user"], "description": "角色" },
          "daily_limit": { "type": "integer", "description": "每日限额" },
          "no_ad_quota": { "type": "integer", "description": "免广告额度" },
          "total_links": { "type": "integer", "description": "链接总数" },
          "status": { "type": "integer", "enum": [0, 1], "description": "状态 0=禁用 1=正常" },
          "created_at": { "type": "string", "format": "date-time", "description": "创建时间" },
          "last_login_at": { "type": "string", "format": "date-time", "description": "最后登录" }
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "链接ID" },
          "short_code": { "type": "string", "description": "短码" },
          "short_url": { "type": "string", "description": "完整短链" },
          "original_url": { "type": "string", "description": "原始链接" },
          "title": { "type": "string", "description": "备注标题" },
          "pv": { "type": "integer", "description": "页面访问量" },
          "uv": { "type": "integer", "description": "独立访客数" },
          "ip_count": { "type": "integer", "description": "独立IP数" },
          "status": { "type": "integer", "enum": [0, 1, 2], "description": "状态 0=禁用 1=正常 2=过期" },
          "expire_at": { "type": "string", "format": "date-time", "description": "过期时间" },
          "is_deleted": { "type": "integer", "description": "是否删除" },
          "created_at": { "type": "string", "format": "date-time", "description": "创建时间" }
        }
      },
      "Ad": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "广告ID" },
          "name": { "type": "string", "description": "广告名称" },
          "type": { "type": "string", "enum": ["banner", "countdown"], "description": "广告类型" },
          "position": { "type": "string", "description": "展示位置" },
          "image_url": { "type": "string", "description": "广告图片" },
          "link_url": { "type": "string", "description": "跳转地址" },
          "is_global": { "type": "integer", "description": "是否全局" },
          "status": { "type": "integer", "description": "状态" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Trend": {
        "type": "object",
        "properties": {
          "stat_date": { "type": "string", "description": "日期" },
          "pv": { "type": "integer", "description": "访问量" },
          "uv": { "type": "integer", "description": "独立访客" }
        }
      },
      "Region": {
        "type": "object",
        "properties": {
          "province": { "type": "string", "description": "省份" },
          "city": { "type": "string", "description": "城市" },
          "cnt": { "type": "integer", "description": "访问次数" }
        }
      },
      "Device": {
        "type": "object",
        "properties": {
          "device_type": { "type": "string", "enum": ["desktop", "mobile", "tablet"], "description": "设备类型" },
          "cnt": { "type": "integer", "description": "访问次数" }
        }
      }
    }
  }
}
