# ============================================================
# 极链 · 短链接系统 - OpenResty 配置
# OpenResty 基于 Nginx，支持 Lua 脚本，性能更强
# ============================================================

server {
    listen 80;
    listen 443 ssl http2;
    server_name localhost;  # 修改为你的域名
    
    # SSL 配置（如需 HTTPS）
    # ssl_certificate     /path/to/cert.pem;
    # ssl_certificate_key /path/to/key.pem;
    # ssl_protocols       TLSv1.2 TLSv1.3;
    # ssl_ciphers         HIGH:!aNULL:!MD5;
    
    # 项目根目录
    root /path/to/ysdlj;  # 修改为你的项目路径
    index index.php index.html;
    
    # ============================================================
    # 日志配置
    # ============================================================
    access_log /var/log/openresty/shortlink_access.log combined buffer=32k flush=5s;
    error_log  /var/log/openresty/shortlink_error.log warn;
    
    # ============================================================
    # PHP 处理 - 使用 OpenResty 的 fastcgi_pass
    # ============================================================
    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;  # 修改为你的 PHP-FPM socket
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        
        # PHP 优化参数
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_connect_timeout 60s;
        fastcgi_send_timeout 60s;
        fastcgi_read_timeout 60s;
    }
    
    # ============================================================
    # 短链接跳转规则（核心）
    # OpenResty 可以直接处理短链跳转，无需经过 PHP
    # ============================================================
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    
    # ============================================================
    # 静态资源缓存优化
    # ============================================================
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 365d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # ============================================================
    # API 接口缓存（可选，使用 OpenResty 的 Lua 缓存）
    # ============================================================
    # 如需更高级的缓存控制，可以使用 Lua 脚本
    # location ~ ^/api/ {
    #     access_by_lua_block {
    #         -- Lua 代码实现缓存逻辑
    #     }
    #     try_files $uri /index.php?$query_string;
    # }
    
    # ============================================================
    # 安全配置
    # ============================================================
    
    # 禁止访问敏感文件
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # 禁止访问配置文件
    location ~ /(config|app|database|storage) {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # 禁止访问 .sql 文件
    location ~ \.sql$ {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # ============================================================
    # 性能优化
    # ============================================================
    
    # 开启 gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss;
    
    # 客户端上传限制
    client_max_body_size 10M;
    
    # 超时设置
    client_body_timeout 60s;
    client_header_timeout 60s;
    send_timeout 60s;
}

# ============================================================
# 如需使用 OpenResty 的 Lua 功能优化短链跳转
# 可以创建 Lua 脚本来实现缓存和跳转逻辑
